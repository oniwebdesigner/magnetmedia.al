generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  excerpt   String   @db.VarChar(300)
  content   String   @db.Text
  category  String   @default("Të përgjithshme")
  image     String   @default("/magnetmedia5.jpg")
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Media {
  id        Int      @id @default(autoincrement())
  mime      String
  data      Bytes    @db.LongBlob
  createdAt DateTime @default(now())
}

model Project {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  client    String
  type      String
  category  String
  image     String   @default("/magnetmedia5.jpg")
  year      String   @default("2026")
  intro     String   @db.VarChar(300)
  long      String   @db.Text   // paragrafët, të ndarë me rresht bosh
  sherbime  String   @db.Text   // një shërbim për rresht
  gallery   String   @db.Text   // një URL fotoje për rresht
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}